#!/usr/bin/env bash
#
# Usage: script/install [--dry-run] [--extras] [--skip-packages] [--skip-chsh]
#
# Brings this machine in line with the dotfiles. Safe to run any time: every
# step checks first and only acts when something is missing or wrong, so a
# second run reports "Nothing to change".
#
#   --dry-run        print what would change; change nothing
#   --extras         also install Brewfile.extras (apps, dev libraries; macOS)
#   --skip-packages  skip Homebrew/apt
#   --skip-chsh      leave the login shell alone (implied when stdin isn't a terminal)
#
# Files in the way are moved to ~/.dotfiles-backup/<timestamp>/, never deleted.
# New machine? Use script/bootstrap, which clones the repo and then runs this.

set -eu

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ZSH_DIR=${ZSH:-$HOME/.oh-my-zsh}
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)-$$"
# Names that a release doesn't have (e.g. eza, git-delta on 22.04) are skipped
# neovim isn't here: apt's is too old for the LazyVim config, see install_release_tools
# build-essential: nvim-treesitter compiles its parsers with cc
APT_PACKAGES="build-essential zsh git curl tmux direnv ripgrep fd-find bat jq shellcheck eza grc gh git-delta"
# <topic>/<name>.config dirs only linked on macOS
MACOS_ONLY_CONFIGS="karabiner"
DRY_RUN=no
EXTRAS=no
PACKAGES=yes
CHSH=yes
CHANGES=0
NOTES=""

# has NAME: true when NAME is on PATH.
has() {
	command -v "$1" >/dev/null 2>&1
}

# pretty PATH: PATH with $HOME shown as ~, for messages.
pretty() {
	# shellcheck disable=SC2088 # a literal ~ is the point: this is for display
	case $1 in
		"$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
		*) echo "$1" ;;
	esac
}

# act DESCRIPTION COMMAND...: counts a change and runs COMMAND, or with
# --dry-run only prints what it would do.
act() {
	CHANGES=$((CHANGES + 1))
	if [ "$DRY_RUN" = yes ]; then
		echo "  would $1"
		return 0
	fi
	echo "  $1"
	shift
	"$@"
}

# warn MESSAGE: prints a problem the run can't fix by itself.
warn() {
	echo "  warning: $1" >&2
}

# backup PATH: moves PATH under $BACKUP_DIR, keeping its path relative to ~.
backup() {
	local dest="$BACKUP_DIR/${1#"$HOME"/}"
	mkdir -p "$(dirname "$dest")"
	mv "$1" "$dest"
}

# link_file SOURCE TARGET: makes TARGET a symlink to SOURCE, backing up
# whatever was there. No-op when the link is already right.
link_file() {
	local src=$1 target=$2
	if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
		return 0
	fi
	if [ -e "$target" ] || [ -L "$target" ]; then
		act "back up $(pretty "$target") to $(pretty "$BACKUP_DIR")" backup "$target"
	fi
	act "link $(pretty "$target")" ln -s "$src" "$target"
}

# install_packages: Brewfile (plus Brewfile.extras with --extras) on macOS,
# $APT_PACKAGES on Debian/Ubuntu. Installs only what's missing; never upgrades.
install_packages() {
	echo "packages"
	[ "$PACKAGES" = yes ] || { echo "  skipped"; return 0; }

	if [ "$(uname -s)" = Darwin ]; then
		local brew_bin brewfile
		for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
			[ -x "$brew_bin" ] && eval "$("$brew_bin" shellenv)" && break
		done
		if ! has brew; then
			act "install Homebrew" /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
			[ "$DRY_RUN" = yes ] && return 0
			for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
				[ -x "$brew_bin" ] && eval "$("$brew_bin" shellenv)" && break
			done
		fi
		# A second account on a Mac can use another user's Homebrew but not write to it
		if [ ! -w "$(brew --repository)" ]; then
			warn "Homebrew belongs to $(stat -f %Su "$(brew --repository)"); run the install as that user to install Brewfile packages"
			return 0
		fi
		for brewfile in "$DOTFILES/Brewfile" $([ "$EXTRAS" = yes ] && echo "$DOTFILES/Brewfile.extras"); do
			if ! brew bundle check --no-upgrade --file="$brewfile" >/dev/null 2>&1; then
				act "brew bundle $(basename "$brewfile")" brew bundle install --no-upgrade --file="$brewfile"
			fi
		done
	elif has apt-get; then
		local pkg missing="" available="" unavailable=""
		for pkg in $APT_PACKAGES; do
			dpkg -s "$pkg" >/dev/null 2>&1 || missing="$missing $pkg"
		done
		[ -n "$missing" ] || return 0
		# Fresh images ship without package lists, so nothing looks installable
		if ! ls /var/lib/apt/lists/*_Packages* >/dev/null 2>&1; then
			act "apt-get update" sudo apt-get update -qq
		fi
		for pkg in $missing; do
			if apt-cache show "$pkg" >/dev/null 2>&1; then
				available="$available $pkg"
			else
				unavailable="$unavailable $pkg"
			fi
		done
		if [ -n "$available" ]; then
			# shellcheck disable=SC2086 # one package per word
			act "apt-get install$available" sudo apt-get install -y $available
		fi
		[ -z "$unavailable" ] || warn "not in this release's apt repos, skipped:$unavailable"
		[ "$EXTRAS" = yes ] && warn "--extras is macOS-only (Brewfile.extras)"
	else
		warn "no Homebrew or apt-get; install what you want from Brewfile by hand"
	fi
	return 0
}

# linux_arch: prints x86_64 or arm64 for this machine, or nothing if neither.
linux_arch() {
	case $(uname -m) in
		x86_64|amd64) echo x86_64 ;;
		aarch64|arm64) echo arm64 ;;
		*) ;;
	esac
}

# install_neovim ARCH: unpacks the latest neovim release into ~/.local/nvim and
# links ~/.local/bin/nvim to it. Returns non-zero (leaving any old copy) on failure.
install_neovim() {
	local tmp
	tmp=$(mktemp -d) || return 1
	curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-$1.tar.gz" \
		| tar -xz -C "$tmp" || { rm -rf "$tmp"; return 1; }
	rm -rf "$HOME/.local/nvim"
	mv "$tmp"/nvim-* "$HOME/.local/nvim" || return 1
	rm -rf "$tmp"
	ln -sf "$HOME/.local/nvim/bin/nvim" "$HOME/.local/bin/nvim"
}

# install_carapace ARCH: puts the latest carapace-bin release in ~/.local/bin.
# There's no install script, so the asset URL comes from the GitHub API.
install_carapace() {
	local arch=$1 url tmp
	[ "$arch" = x86_64 ] && arch=amd64
	url=$(curl -fsSL https://api.github.com/repos/carapace-sh/carapace-bin/releases/latest \
		| grep -o "https://[^\"]*_linux_${arch}\.tar\.gz" | head -1)
	[ -n "$url" ] || return 1
	tmp=$(mktemp -d) || return 1
	curl -fsSL "$url" | tar -xz -C "$tmp" carapace || { rm -rf "$tmp"; return 1; }
	mv "$tmp/carapace" "$HOME/.local/bin/carapace"
	rm -rf "$tmp"
}

# install_starship / install_mise: run each project's official install script
# into ~/.local/bin. `curl | sh` hides a failed download, so check the result.
install_starship() {
	curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin" >/dev/null
	[ -x "$HOME/.local/bin/starship" ]
}
install_mise() {
	curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh >/dev/null
	[ -x "$HOME/.local/bin/mise" ]
}

# install_release_tools: on Linux, tools apt lacks or ships too old, from their
# upstream releases into ~/.local/bin (neovim, starship, mise, carapace). Each
# installs only when missing; a failed download warns instead of stopping.
install_release_tools() {
	[ "$PACKAGES" = yes ] && [ "$(uname -s)" = Linux ] || return 0
	echo "release tools"
	local arch bin="$HOME/.local/bin"
	arch=$(linux_arch)
	if [ -z "$arch" ]; then
		warn "no release builds for $(uname -m); skipping neovim, starship, mise, carapace"
		return 0
	fi
	[ -d "$bin" ] || act "create ~/.local/bin" mkdir -p "$bin"

	# Always the upstream release, even if apt's neovim is installed
	if [ ! -x "$bin/nvim" ]; then
		act "install neovim (latest release) to ~/.local/nvim" install_neovim "$arch" \
			|| warn "neovim download failed"
	fi
	if ! has starship && [ ! -x "$bin/starship" ]; then
		act "install starship to ~/.local/bin" install_starship || warn "starship install failed"
	fi
	if ! has mise && [ ! -x "$bin/mise" ]; then
		act "install mise to ~/.local/bin" install_mise || warn "mise install failed"
	fi
	if ! has carapace && [ ! -x "$bin/carapace" ]; then
		act "install carapace (latest release) to ~/.local/bin" install_carapace "$arch" \
			|| warn "carapace download failed"
	fi
	return 0
}

# install_shell: zsh as login shell, oh-my-zsh, and zsh-autosuggestions
# (cloned when missing, fast-forwarded otherwise).
install_shell() {
	echo "shell"
	local plugin="$DOTFILES/zsh/plugins/zsh-autosuggestions" before

	if ! has zsh; then
		warn "zsh isn't installed"
	elif [ "$CHSH" = yes ]; then
		case ${SHELL:-} in
			*/zsh) ;;
			*)
				# chsh only accepts shells listed in /etc/shells
				local zsh_path
				zsh_path=$(command -v zsh)
				grep -qx "$zsh_path" /etc/shells || zsh_path=$(grep -m1 '/zsh$' /etc/shells || true)
				if [ -n "$zsh_path" ]; then
					act "change login shell to $zsh_path" chsh -s "$zsh_path"
				else
					warn "no zsh in /etc/shells; add one, then run: chsh -s \$(command -v zsh)"
				fi
				;;
		esac
	fi

	if [ ! -d "$ZSH_DIR" ]; then
		act "clone oh-my-zsh to $(pretty "$ZSH_DIR")" git clone -q --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$ZSH_DIR"
	fi

	if [ ! -d "$plugin" ]; then
		act "clone zsh-autosuggestions" git clone -q --depth 1 https://github.com/zsh-users/zsh-autosuggestions "$plugin"
	elif [ "$DRY_RUN" = no ]; then
		before=$(git -C "$plugin" rev-parse HEAD)
		git -C "$plugin" pull -q --ff-only 2>/dev/null || warn "couldn't update zsh-autosuggestions"
		if [ "$(git -C "$plugin" rev-parse HEAD)" != "$before" ]; then
			CHANGES=$((CHANGES + 1))
			echo "  updated zsh-autosuggestions"
		fi
	fi
	return 0
}

# setup_links: <topic>/<name>.symlink -> ~/.<name>, <topic>/<name>.config ->
# ~/.config/<name>. A .symlink directory (ssh.symlink, claude.symlink) becomes
# a real ~/.<name> directory with only its git-tracked top-level entries linked
# in (a tracked subdirectory is linked whole), so private keys and app state
# stay out of the repo. An older whole-directory link is left alone.
setup_links() {
	echo "links"
	local dotfile target entry
	for dotfile in "$DOTFILES"/*/*.symlink; do
		target="$HOME/.$(basename "$dotfile" .symlink)"
		if [ ! -d "$dotfile" ]; then
			link_file "$dotfile" "$target"
		elif [ -L "$target" ] && [ "$(readlink "$target")" = "$dotfile" ]; then
			warn "$(pretty "$target") links to the whole repo directory; move it to a real directory (see README)"
		else
			if [ -L "$target" ] || { [ -e "$target" ] && [ ! -d "$target" ]; }; then
				act "back up $(pretty "$target") to $(pretty "$BACKUP_DIR")" backup "$target"
			fi
			[ -d "$target" ] || act "create $(pretty "$target")" mkdir -m 700 "$target"
			while IFS= read -r entry; do
				link_file "$dotfile/$entry" "$target/$entry"
			done < <(git -C "$DOTFILES" ls-files -- "${dotfile#"$DOTFILES"/}" | cut -d/ -f3 | sort -u)
		fi
	done

	[ -d "$HOME/.config" ] || act "create ~/.config" mkdir -p "$HOME/.config"
	local name
	for dotfile in "$DOTFILES"/*/*.config; do
		[ -d "$dotfile" ] || continue
		name=$(basename "$dotfile" .config)
		case " $MACOS_ONLY_CONFIGS " in
			*" $name "*) [ "$(uname -s)" = Darwin ] || continue ;;
		esac
		link_file "$dotfile" "$HOME/.config/$name"
	done
}

# prune_links: removes broken symlinks in ~, ~/.ssh, ~/.claude and ~/.config
# that point into this repo (left behind when a file is removed from the dotfiles).
prune_links() {
	local link
	for link in "$HOME"/.* "$HOME"/.ssh/* "$HOME"/.claude/* "$HOME"/.config/*; do
		if [ -L "$link" ] && [ ! -e "$link" ]; then
			case $(readlink "$link") in
				"$DOTFILES"/*) act "remove stale link $(pretty "$link")" rm "$link" ;;
			esac
		fi
	done
}

# setup_config: one-time files that are personal, so copied rather than linked.
setup_config() {
	echo "config"
	if [ ! -e "$HOME/.gitconfig" ] && [ ! -L "$HOME/.gitconfig" ]; then
		act "create ~/.gitconfig from git/gitconfig.symlink.example" \
			cp "$DOTFILES/git/gitconfig.symlink.example" "$HOME/.gitconfig"
		NOTES="$NOTES  * fill in your name and email in ~/.gitconfig\n"
	fi
	if has starship && [ ! -e "$HOME/.config/starship.toml" ]; then
		act "write the starship pure preset to ~/.config/starship.toml" \
			starship preset pure-preset -o "$HOME/.config/starship.toml"
	fi
}

# restore_nvim_plugins NVIM LAZY_DIR LOG: launches NVIM once so lazy.nvim
# installs the plugins, then restores them to lazy-lock.json, writing nvim's
# output to LOG. The first-launch install takes most plugins at their latest
# commit and rewrites the lockfile, so the committed lockfile is put back
# before and after the restore. True when LazyVim ended up in LAZY_DIR.
restore_nvim_plugins() {
	local lock="$HOME/.config/nvim/lazy-lock.json" saved
	saved=$(mktemp)
	cp "$lock" "$saved"
	mkdir -p "$(dirname "$3")"
	"$1" --version >"$3" 2>&1 || true
	"$1" --headless +qa >>"$3" 2>&1 || true
	cp "$saved" "$lock"
	"$1" --headless "+Lazy! restore" +qa >>"$3" 2>&1 || true
	cp "$saved" "$lock"
	rm -f "$saved"
	[ -d "$2/LazyVim" ]
}

# setup_nvim_plugins: on a machine with nvim but no lazy.nvim plugins yet,
# installs them at the commits in lazy-lock.json. Later runs leave plugins alone.
setup_nvim_plugins() {
	local nvim lazy_dir="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy"
	local log="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/nvim-install.log"
	nvim=$(command -v nvim || echo "$HOME/.local/bin/nvim")
	if [ ! -x "$nvim" ] || [ ! -e "$HOME/.config/nvim" ] || [ -d "$lazy_dir" ]; then
		return 0
	fi
	echo "nvim"
	act "install nvim plugins from lazy-lock.json" restore_nvim_plugins "$nvim" "$lazy_dir" "$log" \
		|| warn "nvim plugin install failed (output in $(pretty "$log")); run :Lazy restore in nvim"
}

# converge_files: every step that only touches files under ~ (no network).
converge_files() {
	setup_links
	prune_links
	setup_config
}

# main [flags]: parses flags (see top of file), runs each step, then summarizes.
main() {
	[ -t 0 ] || CHSH=no
	while [ $# -gt 0 ]; do
		case $1 in
			--dry-run) DRY_RUN=yes ;;
			--extras) EXTRAS=yes ;;
			--skip-packages) PACKAGES=no ;;
			--skip-chsh|--unattended) CHSH=no ;;
			-h|--help) sed -n '3,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; return 0 ;;
			*) echo "unknown option: $1 (see --help)" >&2; return 1 ;;
		esac
		shift
	done

	[ "$DOTFILES" = "$HOME/.dotfiles" ] || warn "repo is at $DOTFILES, but zshrc expects ~/.dotfiles"

	install_packages
	install_release_tools
	install_shell
	converge_files
	setup_nvim_plugins

	echo
	if [ "$CHANGES" -eq 0 ]; then
		echo "Nothing to change."
	elif [ "$DRY_RUN" = yes ]; then
		echo "$CHANGES change(s) would be made. Run without --dry-run to apply."
	else
		echo "Done: $CHANGES change(s). Open a new terminal to pick them up."
	fi
	[ -d "$BACKUP_DIR" ] && echo "Replaced files were backed up to $(pretty "$BACKUP_DIR")."
	[ -z "$NOTES" ] || printf "To do:\n%b" "$NOTES"
	return 0
}

# Run main only when executed, so script/test can source the functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
