# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Machine-specific hosts kept out of this public repo. Missing file is ignored.
Include ~/.ssh/config.local

# UseKeychain is macOS-only; without this, Linux OpenSSH refuses the whole file.
IgnoreUnknown UseKeychain

Host *
  ForwardAgent yes
  TCPKeepAlive yes
  ServerAliveCountMax 12
  ServerAliveInterval 5
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *.amazonaws.com
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no

Host jpdo
  User jonphenow
  HostName do.jphenow.com

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  # IdentityFile ~/.ssh/ms_id_rsa

# GITHUB

Host gh
  User git
  Port 22
  HostName github.com
  TCPKeepAlive yes
  IdentitiesOnly yes
Host github.com *.github.net *.githubapp.com
  ForwardAgent no
  User jphenow
  IdentityFile ~/github/ssh/id_rsa

    IdentityFile ~/.ssh/id_ed25519

    IdentityFile ~/.ssh/id_ed25519
